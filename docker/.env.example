# Nepovinné nastavenie lokálnej appky v Dockeri. Skopíruj ako docker/.env a doplň.
# Súbor docker/.env je v .gitignore a na server sa nenahráva.
#
# Databázu, adresu appky a kľúče na upozornenia nastavuje docker-compose.yml —
# tie sa tu meniť nedajú. Sem patria hlavne kľúče k AI (rovnaké premenné ako
# v includes/.env, pozri includes/.env.example). Bez kľúča appka beží, len bez AI.
#
# Pozor: lokálne skúšanie míňa ten istý denný limit ako appka na serveri,
# ak tu použiješ ten istý kľúč.

GEMINI_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# AI_PORADIE=gemini,groq,claude,openai,mistral
