# Nastavenie testovacej appky na domácom serveri. Skopíruj ako docker/homelab/.env.
# Súbor .env je v .gitignore — na GitHub ani na webhosting sa nedostane.

# --- Kde a ako appka beží ---
# Priečinok, kam si naklonoval repozitár (musí sedieť, inak aktualizátor nič nenájde).
RECEPTY_CESTA=/opt/recepty-test
# Fotky, kuchárky a databáza testovacej appky (napr. na ZFS pool „data").
RECEPTY_DATA=/data/recepty-test
# Port na serveri. V Nginx Proxy Manager nasmeruj recepty.home → IP_SERVERA:8095.
RECEPTY_PORT=8095
# Adresa appky bez http:// (rovnaká, akú dáš do Nginx Proxy Manager).
RECEPTY_HOST=recepty.home
# Celá adresa — ťuknutie na upozornenie ju otvorí.
RECEPTY_ADRESA=http://recepty.home
# Rozsah siete Dockeru pre tento stack — nesmie sa biť s inými stackmi. Obsadené rozsahy vypíše:
#   sudo docker network inspect $(sudo docker network ls -q) --format '{{.Name}} {{range .IPAM.Config}}{{.Subnet}} {{end}}'
RECEPTY_SIET=172.16.1.0/24

# --- Aktualizátor ---
# Vetva na GitHube, z ktorej sa testovacia appka nasadzuje.
RECEPTY_VETVA=test
# Ako často sa pozerá na GitHub (sekundy).
RECEPTY_INTERVAL=60
# Upozornenie po nasadení cez ntfy, napr. http://ntfy.home/recepty-test (prázdne = bez upozornenia).
RECEPTY_NTFY=

# --- Prihlásenie a heslá (len pre testovaciu appku) ---
# Admin sa založí pri prvom štarte. Appka je dostupná v celej domácej sieti, zmeň heslo.
RECEPTY_ADMIN_MENO=admin
RECEPTY_ADMIN_HESLO=zmen-ma
RECEPTY_DB_HESLO=zmen-ma-db
RECEPTY_DB_ROOT_HESLO=zmen-ma-root
RECEPTY_CRON_KEY=zmen-ma-cron-kluc

# --- AI (nepovinné), rovnaké premenné ako v includes/.env ---
# Pozor: ten istý kľúč míňa ten istý denný limit ako appka pre rodinu.
GEMINI_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_PORADIE=gemini,groq,claude,openai,mistral
