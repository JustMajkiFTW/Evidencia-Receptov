# Vzor nastavenia appky. Skopíruj tento súbor ako includes/.env a doplň hodnoty.
# Súbor .env obsahuje heslá a kľúče — nikdy ho nedávaj na GitHub ani nikomu neposielaj.
# Najjednoduchšie je otvoriť v prehliadači install.php: pripraví celý obsah aj s kľúčmi.

# --- Databáza (MariaDB / MySQL) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
# Heslo nesmie byť prázdne — pre appku si vytvor vlastného používateľa databázy s heslom.
DB_PASS=
DB_CHARSET=utf8mb4

# --- Adresa appky ---
# Len doména, bez https:// a bez lomky na konci, napr. recepty.example.com
# Biometria (odtlačok / Face ID) funguje len vtedy, keď appka beží na https://APP_HOST
APP_HOST=

# --- Upozornenia (Web Push) ---
# Pár kľúčov VAPID vo formáte base64url. Vygeneruje ich install.php.
# Po zmene kľúčov si musia všetci používatelia upozornenia povoliť znova.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt na správcu appky v tvare mailto:meno@domena.sk (vyžadujú ho služby, ktoré upozornenia doručujú)
VAPID_SUBJECT=

# --- Pripomienky „dlho ste nevarili" ---
# Tajný kľúč (aspoň 16 znakov) pre adresu cron.php?key=... Prázdne = cron.php je vypnutý.
CRON_KEY=

# --- Recept z fotky cez AI (nepovinné) ---
# Kľúč aspoň k jednej službe zapne v appke „Odfotiť" (telefón) a „Vyplniť z fotky" (formulár).
# Bez kľúča appka beží ako doteraz. Kľúče sa platia zvlášť, nie cez predplatné ChatGPT či Claude.
#   Gemini:  https://aistudio.google.com/apikey  (má aj bezplatnú úroveň s denným limitom)
#   Claude:  https://platform.claude.com/        (Settings → API keys)
#   OpenAI:  https://platform.openai.com/api-keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# V akom poradí služby skúšať — keď prvá zlyhá (limit, výpadok), skúsi sa ďalšia. Služby bez kľúča sa preskočia.
AI_PORADIE=gemini,claude,openai
# Koľko fotiek môže jeden používateľ poslať za deň (0 = bez limitu).
AI_DENNY_LIMIT=20
# Iný model než predvolený (gemini-3.8-flash, claude-haiku-5-5, gpt-6-luna) — väčšinou netreba.
# AI_MODEL_GEMINI=
# AI_MODEL_CLAUDE=
# AI_MODEL_OPENAI=

# --- Ladenie ---
# 1 = presná chyba sa zobrazí na obrazovke. V bežnej prevádzke nechaj 0.
APP_DEBUG=0
