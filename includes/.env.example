# Vzor nastavenia appky. Skopíruj tento súbor ako includes/.env a doplň hodnoty.
# Súbor .env obsahuje heslá a kľúče — nikdy ho nedávaj na GitHub ani nikomu neposielaj.
# Najjednoduchšie je otvoriť v prehliadači install.php: pripraví celý obsah aj s kľúčmi.

# --- Databáza (MariaDB / MySQL) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
# Heslo nesmie byť prázdne — pre appku si vytvor vlastného používateľa databázy s heslom.
DB_PASS=
DB_CHARSET=utf8mb4

# --- Adresa appky ---
# Len doména, bez https:// a bez lomky na konci, napr. recepty.example.com
# Biometria (odtlačok / Face ID) funguje len vtedy, keď appka beží na https://APP_HOST
APP_HOST=

# --- Upozornenia (Web Push) ---
# Pár kľúčov VAPID vo formáte base64url. Vygeneruje ich install.php.
# Po zmene kľúčov si musia všetci používatelia upozornenia povoliť znova.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt na správcu appky v tvare mailto:meno@domena.sk (vyžadujú ho služby, ktoré upozornenia doručujú)
VAPID_SUBJECT=

# --- Pripomienky „dlho ste nevarili" ---
# Tajný kľúč (aspoň 16 znakov) pre adresu cron.php?key=... Prázdne = cron.php je vypnutý.
CRON_KEY=

# --- Recept z fotky cez AI (nepovinné) ---
# Kľúč aspoň k jednej službe zapne v appke „Odfotiť" (telefón) a „Vyplniť z fotky" (formulár).
# Bez kľúča appka beží ako doteraz. Kľúče sa platia zvlášť, nie cez predplatné ChatGPT či Claude.
#   Gemini:  https://aistudio.google.com/apikey  (má aj bezplatnú úroveň s denným limitom)
#   Claude:  https://platform.claude.com/        (Settings → API keys)
#   OpenAI:  https://platform.openai.com/api-keys
#   Mistral: https://console.mistral.ai/  (bezplatný režim bez karty, limity pre každý model zvlášť; od 3.2)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# V akom poradí služby skúšať — keď prvá zlyhá (limit, výpadok), skúsi sa ďalšia. Služby bez kľúča sa preskočia.
# Zadarmo: gemini,mistral — keď Gemini minie denný limit, odpovie Mistral.
AI_PORADIE=gemini,mistral,claude,openai
# Koľko fotiek môže jeden používateľ poslať za deň (0 = bez limitu).
AI_DENNY_LIMIT=20
# Koľko otázok môže jeden používateľ položiť hlasovému asistentovi za deň (0 = bez limitu).
# Asistent používa tie isté kľúče a poradie ako recept z fotky (od verzie 2.7).
AI_ASISTENT_DENNY_LIMIT=100
# Iný (rýchlejší) model len pre hlasového asistenta, napr. AI_ASISTENT_MODEL_GEMINI=gemini-flash-lite-latest.
# Prázdne = tie isté modely ako pri recepte z fotky.
AI_ASISTENT_MODEL_GEMINI=
AI_ASISTENT_MODEL_CLAUDE=
AI_ASISTENT_MODEL_OPENAI=
AI_ASISTENT_MODEL_MISTRAL=
# Iné modely než predvolené — väčšinou netreba. Viac modelov oddeľ čiarkou, skúšajú sa
# v tomto poradí (ďalší, keď je predošlý preťažený alebo neodpovedá). Predvolené:
# Gemini gemini-3.8-flash,gemini-flash-lite-latest · Claude claude-haiku-5-5 · OpenAI gpt-6-luna
# Mistral mistral-medium-latest,mistral-small-latest
# Pri bezplatných verziách má každý model vlastný denný limit — daj na prvé miesto ten s najvyšším
# (Gemini: aistudio.google.com/rate-limit), napr. AI_MODEL_GEMINI=gemini-flash-lite-latest,gemini-3.8-flash.
# AI_MODEL_GEMINI=
# AI_MODEL_CLAUDE=
# AI_MODEL_OPENAI=
# AI_MODEL_MISTRAL=

# --- Ladenie ---
# 1 = presná chyba sa zobrazí na obrazovke. V bežnej prevádzke nechaj 0.
APP_DEBUG=0

# Prepis hlasu z iPhonu (3.2): vlastné modely, aby prepis nemíňal limit modelu, ktorý odpovedá.
# Prázdne = Gemini modely asistenta, Mistral voxtral-mini-latest, OpenAI gpt-4o-mini-transcribe.
# AI_PREPIS_MODEL_GEMINI=
# AI_PREPIS_MODEL_MISTRAL=
# AI_PREPIS_MODEL_OPENAI=

# Kuchárky v PDF (2.8): iný priečinok na serveri. Prázdne = kucharky/ v appke.
# KUCHARKY_PRIECINOK=
